<body>
nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48px;
  padding: 16px 24px;
  background: #eeb7b7;
  border: 1px solid #f57e7e;
  border-radius: 12px;
}

nav h1 {
  margin: 0;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: #f2c36c;
}

#nav-ul {
  list-style: none;
  display: flex;
  gap: 8px;
  margin: 0;
  padding: 0;
}

.nav-li a {
  color: #f2db74;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
  padding: 6px 14px;
  border-radius: 8px;
  transition:
    background 0.25s ease,
    color 0.25s ease;
}

.nav-li a:hover {
  background: #be7947;
  color: #fff;
}
</body>